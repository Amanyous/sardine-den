{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html",
      "default_title": "Quick add bookmark"
   },
   "background": {
      "service_worker": "bg.js"
   },
   "chrome_url_overrides": {
      "newtab": "newtab.html"
   },
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self';"
   },
   "description": "Glass-style new tab dashboard. Search uses Chrome Search API and respects the user's default search engine.",
   "host_permissions": [ "https://gntd.us/*", "https://api.gntd.us/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "GNTD: Glass New Tab Dashboard",
   "optional_host_permissions": [ "https://*.youtube.com/*", "https://youtu.be/*", "https://open.spotify.com/*", "https://*.soundcloud.com/*", "https://on.soundcloud.com/*" ],
   "optional_permissions": [ "bookmarks", "notifications", "history", "unlimitedStorage", "scripting" ],
   "permissions": [ "storage", "contextMenus", "tabs", "search", "identity" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.2.12"
}
